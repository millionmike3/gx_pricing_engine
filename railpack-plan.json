{
  "$schema": "https://railpack.com/schema/railpack-plan.json",
  "build": {
    "root": ".",
    "exclude": [
      ".venv",
      "venv"
    ],
    "steps": [
      {
        "name": "Install Python dependencies",
        "run": "pip install -r requirements.txt"
      }
    ]
  },
  "deploy": {
    "run": "bash backend/start.sh"
  }
}
